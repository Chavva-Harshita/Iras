DB_URL=jdbc:postgresql://localhost:5432/iras
DB_USERNAME=postgres
DB_PASSWORD=your_local_password
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FLYWAY_ENABLED=true

# JWT Configuration (placeholders only - do not commit real secrets)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_must_be_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_must_be_at_least_32_characters_long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# OTP Configuration
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_EXPOSE_IN_DEV_RESPONSE=true

# Security Cookie
COOKIE_SECURE=false
